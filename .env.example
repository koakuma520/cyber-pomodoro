# ===== 微信配置（必填）=====
# 公众号 AppID — 在 mp.weixin.qq.com → 设置与开发 → 基本配置 获取
WX_APPID=wx0000000000000000

# 公众号 AppSecret — 同上位置获取
WX_SECRET=your_app_secret_here

# ===== 微信支付配置（开通微信支付后填写）=====
# 商户号 — 在 pay.weixin.qq.com 获取
WX_MCHID=1234567890

# 商户 APIv2 密钥 — 商户平台 → 账户中心 → API安全 设置
WX_MCH_KEY=your_mch_key_here

# 支付回调地址 — 必须是公网可访问的 HTTPS 地址
WX_NOTIFY_URL=https://你的域名/api/wechat/pay/notify

# ===== 服务器配置 =====
# JWT 密钥（生产环境必须设置固定值）
JWT_SECRET=your_jwt_secret_here

# 服务器端口
PORT=3457

# ===== 管理员账号（可选，默认 admin/admin123）=====
# ADMIN_USER=admin
# ADMIN_PASS=admin123
