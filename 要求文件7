<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Seedance Studio 2.0 - AI视频生成平台</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(145deg, #0a0c14 0%, #0f111a 100%);
            font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, sans-serif;
            color: #eef2ff;
            padding: 24px;
        }

        /* 自定义滚动条 */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1e1f2e;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b3f5c;
            border-radius: 10px;
        }

        .glass-card {
            background: rgba(18, 22, 35, 0.8);
            backdrop-filter: blur(2px);
            border: 1px solid rgba(72, 85, 120, 0.35);
            border-radius: 28px;
            transition: all 0.2s ease;
        }

        .btn-primary {
            background: linear-gradient(105deg, #6366f1 0%, #8b5cf6 100%);
            border: none;
            padding: 10px 20px;
            border-radius: 40px;
            font-weight: 600;
            color: white;
            cursor: pointer;
            transition: 0.2s;
            box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
        }
        .btn-primary:hover {
            transform: translateY(-1px);
            filter: brightness(1.05);
            box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4);
        }
        .btn-secondary {
            background: #2d2f42;
            border: 1px solid #4a4f73;
            border-radius: 40px;
            padding: 8px 18px;
            font-weight: 500;
            color: #d1d5ff;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-secondary:hover {
            background: #3d405b;
        }
        input, select, textarea {
            background: #131622;
            border: 1px solid #2c2f45;
            border-radius: 20px;
            padding: 12px 16px;
            color: white;
            font-size: 0.9rem;
            outline: none;
            transition: 0.2s;
        }
        input:focus, select:focus, textarea:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
        }
        .badge {
            background: #1e1f2e;
            border-radius: 30px;
            padding: 4px 12px;
            font-size: 0.75rem;
            color: #a5b4fc;
        }
        .video-preview {
            background: #00000040;
            border-radius: 24px;
            overflow: hidden;
            aspect-ratio: 16 / 9;
            width: 100%;
            object-fit: cover;
        }
        .history-item {
            background: #0f111a;
            border-radius: 20px;
            padding: 12px;
            margin-bottom: 12px;
            border-left: 3px solid #8b5cf6;
        }
        .gradient-text {
            background: linear-gradient(135deg, #c084fc, #60a5fa);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .login-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(10px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            width: 420px;
            max-width: 90%;
        }
        .credit-amount {
            font-weight: 800;
            font-size: 1.6rem;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
    </style>
</head>
<body>

<div id="app">
    <!-- 登录界面容器 -->
    <div id="loginContainer" class="login-overlay">
        <!-- 动态渲染登录或注册 -->
    </div>

    <!-- 主应用界面 (初始隐藏) -->
    <div id="mainApp" style="display: none;">
        <div class="max-w-[1600px] mx-auto">
            <!-- 头部导航 -->
            <div class="flex flex-wrap justify-between items-center mb-6 gap-4">
                <div class="flex items-center gap-3">
                    <h1 class="text-2xl font-bold tracking-tight">✨ Seedance Studio</h1>
                    <span class="badge">Atlas Cloud <span style="color:#f97316;">● 未连接</span></span>
                </div>
                <div class="flex items-center gap-3 flex-wrap">
                    <div class="glass-card px-4 py-2 rounded-full flex items-center gap-2">
                        <span>⭐ 积分余额</span>
                        <span id="creditBalance" class="font-bold text-xl text-amber-300">0</span>
                        <span>分</span>
                    </div>
                    <button id="rechargeBtn" class="btn-secondary text-sm">💰 充值积分</button>
                    <button id="claimFreeBtn" class="btn-secondary text-sm">🎁 免费领取$1额度</button>
                    <button id="logoutBtn" class="btn-secondary text-sm">🚪 退出</button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- 左侧主表单 -->
                <div class="lg:col-span-2 glass-card p-5 space-y-5">
                    <div class="flex gap-3 border-b border-white/10 pb-3">
                        <button id="txt2videoTab" class="tab-btn active-tab px-5 py-2 rounded-full font-medium">📝 文生视频</button>
                        <button id="img2videoTab" class="tab-btn px-5 py-2 rounded-full font-medium">🖼️ 图生视频</button>
                    </div>

                    <!-- 提示词区域 -->
                    <div>
                        <label class="block text-sm font-medium mb-1">提示词 (中英文结合效果更佳)</label>
                        <textarea id="promptInput" rows="3" class="w-full resize-none" placeholder="例：一只柴犬在雪地里奔跑，电影质感，柔和自然光，cyberpunk neon details"></textarea>
                        <div class="text-xs text-gray-400 mt-1">✨ Seedance2.0 对英文提示词理解更佳，建议中英文结合使用</div>
                    </div>

                    <!-- 图生视频上传区 (默认隐藏) -->
                    <div id="imgUploadArea" style="display: none;">
                        <label class="block text-sm font-medium mb-1">上传参考图片</label>
                        <input type="file" id="imageUpload" accept="image/jpeg,image/png,image/jpg" class="w-full">
                        <div id="imgPreview" class="mt-2 w-32 h-32 rounded-lg overflow-hidden border border-dashed border-gray-500 hidden"></div>
                    </div>

                    <!-- 参数栏 -->
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div>
                            <label class="text-xs text-gray-400">模型</label>
                            <select id="modelSelect" class="w-full text-sm">
                                <option>Seedance 2.0</option>
                                <option>Seedance Pro</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">分辨率</label>
                            <select id="resolutionSelect" class="w-full text-sm">
                                <option>720p</option>
                                <option>1080p</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">比例</label>
                            <select id="ratioSelect" class="w-full text-sm">
                                <option>自适应</option>
                                <option>16:9</option>
                                <option>9:16</option>
                                <option>1:1</option>
                            </select>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400">时长</label>
                            <select id="durationSelect" class="w-full text-sm">
                                <option>5秒</option>
                                <option>10秒</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex flex-wrap gap-4 justify-between items-center">
                        <div class="flex gap-3">
                            <label class="flex items-center gap-1 text-sm"><input type="checkbox" id="soundEffect"> 自动匹配环境音效</label>
                            <label class="flex items-center gap-1 text-sm"><input type="checkbox" id="watermark"> 包含平台水印</label>
                        </div>
                        <div class="bg-black/30 px-4 py-2 rounded-full">
                            <span class="text-sm">💰 预估费用: <strong id="estCost" class="text-yellow-300">3.6</strong> 元  (36 积分)</span>
                        </div>
                    </div>

                    <button id="generateBtn" class="btn-primary w-full py-3 text-lg">✨ 开始生成视频</button>
                    <div id="genStatus" class="text-sm text-center text-indigo-300"></div>

                    <!-- 生成视频展示区 -->
                    <div id="resultVideoArea" class="mt-2 hidden">
                        <p class="mb-2 text-sm font-semibold">🎬 生成结果</p>
                        <video id="generatedVideo" controls class="video-preview w-full rounded-xl"></video>
                    </div>
                </div>

                <!-- 右侧历史记录 + 灵感墙 -->
                <div class="space-y-5">
                    <div class="glass-card p-4">
                        <h3 class="font-bold flex items-center gap-2 mb-3">📜 历史记录</h3>
                        <div id="historyList" class="max-h-[320px] overflow-y-auto space-y-2">
                            <div class="text-gray-400 text-sm text-center py-4">暂无生成记录</div>
                        </div>
                    </div>
                    <div class="glass-card p-4">
                        <h3 class="font-bold flex items-center gap-2 mb-3">✨ 灵感墙 · 热门提示词</h3>
                        <div class="flex flex-wrap gap-2">
                            <span class="badge cursor-pointer hover:bg-indigo-800/50" data-word="柴犬雪地奔跑赛博朋克">🐕 柴犬赛博朋克</span>
                            <span class="badge cursor-pointer" data-word="水墨风山水画，云雾缭绕, ancient china">🎋 水墨风山水</span>
                            <span class="badge cursor-pointer" data-word="未来城市日落霓虹灯，cyberpunk 2077">🌆 未来城市日落</span>
                            <span class="badge cursor-pointer" data-word="橘猫窗边午后阳光，胶片质感">🐈 橘猫窗边</span>
                            <span class="badge cursor-pointer" data-word="赛博朋克早餐摊，蒸汽波风格">🥟 赛博朋克早餐</span>
                        </div>
                        <div class="mt-4 text-xs text-gray-400">💡 点击灵感词快速填充提示词</div>
                    </div>
                    <!-- 模拟 API Key 配置卡片(装饰) -->
                    <div class="glass-card p-4 opacity-80">
                        <div class="flex justify-between items-center">
                            <span class="font-mono text-sm">🔑 Atlas Cloud API Key</span>
                            <button class="text-xs bg-white/10 px-2 py-1 rounded">保存</button>
                        </div>
                        <div class="text-[11px] text-gray-400 mt-1">未配置 · 免费额度已内置积分系统</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // ---------- 后端API地址 (默认当前origin) ----------
    const API_BASE = '';
    // 辅助函数
    async function apiCall(endpoint, method = 'GET', body = null, needAuth = true) {
        const headers = {
            'Content-Type': 'application/json',
        };
        if (needAuth) {
            const token = localStorage.getItem('accessToken');
            if (!token) throw new Error('未登录');
            headers['Authorization'] = `Bearer ${token}`;
        }
        const config = {
            method,
            headers,
        };
        if (body) config.body = JSON.stringify(body);
        const res = await fetch(`${API_BASE}${endpoint}`, config);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '请求失败');
        return data;
    }

    // 全局状态
    let currentUser = null;
    let currentBalance = 0;

    // 登录/注册渲染
    function renderAuthModal() {
        const container = document.getElementById('loginContainer');
        container.innerHTML = `
            <div class="login-card glass-card p-6">
                <div class="text-center mb-6">
                    <h2 class="text-3xl font-bold gradient-text">Seedance Studio</h2>
                    <p class="text-gray-300 text-sm">AI视频生成 · 积分系统 1元=10积分</p>
                </div>
                <div class="tabs flex gap-2 mb-5">
                    <button id="showLoginBtn" class="flex-1 py-2 rounded-full bg-indigo-600/60">登录</button>
                    <button id="showRegisterBtn" class="flex-1 py-2 rounded-full bg-white/10">注册</button>
                </div>
                <div id="authFormContainer">
                    <!-- 默认登录表单 -->
                    <div>
                        <input type="text" id="loginUsername" placeholder="用户名" class="w-full mb-3">
                        <input type="password" id="loginPassword" placeholder="密码" class="w-full mb-4">
                        <button id="doLoginBtn" class="btn-primary w-full">登录</button>
                        <p class="text-xs text-center text-gray-400 mt-3">👋 测试账号: test / 123456 或 注册新账号</p>
                    </div>
                </div>
            </div>
        `;
        // 绑定事件
        document.getElementById('showLoginBtn')?.addEventListener('click', () => {
            document.getElementById('authFormContainer').innerHTML = `
                <input type="text" id="loginUsername" placeholder="用户名" class="w-full mb-3">
                <input type="password" id="loginPassword" placeholder="密码" class="w-full mb-4">
                <button id="doLoginBtn" class="btn-primary w-full">登录</button>
            `;
            document.getElementById('doLoginBtn')?.addEventListener('click', doLogin);
        });
        document.getElementById('showRegisterBtn')?.addEventListener('click', () => {
            document.getElementById('authFormContainer').innerHTML = `
                <input type="text" id="regUsername" placeholder="用户名" class="w-full mb-3">
                <input type="password" id="regPassword" placeholder="密码" class="w-full mb-3">
                <input type="password" id="regConfirm" placeholder="确认密码" class="w-full mb-4">
                <button id="doRegisterBtn" class="btn-primary w-full">注册并登录</button>
            `;
            document.getElementById('doRegisterBtn')?.addEventListener('click', doRegister);
        });
        document.getElementById('doLoginBtn')?.addEventListener('click', doLogin);
    }

    async function doLogin() {
        const username = document.getElementById('loginUsername')?.value;
        const password = document.getElementById('loginPassword')?.value;
        if (!username || !password) return alert('请输入账号密码');
        try {
            const res = await fetch(`${API_BASE}/api/auth/login`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            localStorage.setItem('accessToken', data.token);
            currentUser = data.user;
            await loadMainApp();
        } catch (err) {
            alert('登录失败: ' + err.message);
        }
    }

    async function doRegister() {
        const username = document.getElementById('regUsername')?.value;
        const password = document.getElementById('regPassword')?.value;
        const confirm = document.getElementById('regConfirm')?.value;
        if (!username || !password) return alert('请填写完整');
        if (password !== confirm) return alert('两次密码不一致');
        try {
            const res = await fetch(`${API_BASE}/api/auth/register`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error);
            localStorage.setItem('accessToken', data.token);
            currentUser = data.user;
            await loadMainApp();
        } catch (err) {
            alert('注册失败: ' + err.message);
        }
    }

    async function loadMainApp() {
        // 拉取用户信息及余额
        try {
            const profile = await apiCall('/api/user/profile');
            currentBalance = profile.balance;
            document.getElementById('creditBalance').innerText = currentBalance;
            document.getElementById('loginContainer').style.display = 'none';
            document.getElementById('mainApp').style.display = 'block';
            await loadHistory();
        } catch (e) {
            alert('会话失效，请重新登录');
            logout();
        }
    }

    async function logout() {
        localStorage.removeItem('accessToken');
        document.getElementById('mainApp').style.display = 'none';
        document.getElementById('loginContainer').style.display = 'flex';
        renderAuthModal();
    }

    async function loadHistory() {
        try {
            const data = await apiCall('/api/generate/history');
            const historyDiv = document.getElementById('historyList');
            if (!data.history || data.history.length === 0) {
                historyDiv.innerHTML = '<div class="text-gray-400 text-sm text-center py-4">暂无生成记录</div>';
                return;
            }
            historyDiv.innerHTML = data.history.map(item => `
                <div class="history-item">
                    <div class="flex justify-between text-xs text-gray-400"><span>${item.mode}</span><span>${new Date(item.createdAt).toLocaleString()}</span></div>
                    <div class="text-sm font-medium truncate">${item.prompt.substring(0, 50)}</div>
                    ${item.videoUrl ? `<video src="${item.videoUrl}" class="w-full h-20 object-cover rounded mt-2" controls preload="none"></video>` : '<span class="text-xs text-rose-300">生成失败或处理中</span>'}
                </div>
            `).join('');
        } catch(e) { console.warn(e); }
    }

    // 刷新余额UI
    async function refreshBalance() {
        try {
            const profile = await apiCall('/api/user/profile');
            currentBalance = profile.balance;
            document.getElementById('creditBalance').innerText = currentBalance;
        } catch(e) {}
    }

    // 充值弹窗模拟
    function rechargeModal() {
        const amount = prompt('请输入充值金额 (元)\n1元 = 10积分', '1');
        if (!amount) return;
        const yuan = parseInt(amount);
        if (isNaN(yuan) || yuan <= 0) return alert('金额无效');
        apiCall('/api/user/recharge', 'POST', { amount: yuan })
            .then(async (data) => {
                alert(`充值成功！增加 ${yuan*10} 积分`);
                await refreshBalance();
            })
            .catch(err => alert('充值失败: ' + err.message));
    }

    // 免费领取额度
    function claimFree() {
        apiCall('/api/user/claim-free', 'POST')
            .then(async (data) => {
                alert(data.message || '领取成功 +10 积分');
                await refreshBalance();
            })
            .catch(err => alert(err.message));
    }

    // 生成视频 (模拟任务)
    async function generateVideo() {
        const mode = document.getElementById('txt2videoTab').classList.contains('active-tab') ? 'txt2video' : 'img2video';
        const prompt = document.getElementById('promptInput').value.trim();
        if (!prompt) return alert('请填写提示词');
        let imageBase64 = null;
        if (mode === 'img2video') {
            const fileInput = document.getElementById('imageUpload');
            if (!fileInput.files.length) return alert('请上传图片');
            const file = fileInput.files[0];
            imageBase64 = await new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = e => resolve(e.target.result.split(',')[1]);
                reader.readAsDataURL(file);
            });
        }
        const model = document.getElementById('modelSelect').value;
        const resolution = document.getElementById('resolutionSelect').value;
        const ratio = document.getElementById('ratioSelect').value;
        const duration = parseInt(document.getElementById('durationSelect').value);
        const soundEffect = document.getElementById('soundEffect').checked;
        const watermark = document.getElementById('watermark').checked;
        const genBtn = document.getElementById('generateBtn');
        const statusDiv = document.getElementById('genStatus');
        genBtn.disabled = true;
        genBtn.innerText = '⏳ 发送请求...';
        statusDiv.innerText = '检查积分余额...';
        try {
            const balanceCheck = await apiCall('/api/user/profile');
            if (balanceCheck.balance < 36) throw new Error('积分不足，请充值 (生成需36积分)');
            statusDiv.innerText = '🎬 任务已提交，AI生成中 (模拟耗时约3秒)...';
            const res = await apiCall('/api/generate/create', 'POST', {
                mode, prompt, imageBase64, model, resolution, ratio, duration, soundEffect, watermark
            });
            const taskId = res.taskId;
            // 轮询
            let videoUrl = null;
            let attempts = 0;
            statusDiv.innerText = '🔄 处理中，请稍后...';
            while (attempts < 20) {
                await new Promise(r => setTimeout(r, 1500));
                const taskRes = await apiCall(`/api/generate/task/${taskId}`);
                if (taskRes.status === 'completed') {
                    videoUrl = taskRes.videoUrl;
                    break;
                } else if (taskRes.status === 'failed') {
                    throw new Error('生成失败');
                }
                attempts++;
            }
            if (!videoUrl) throw new Error('生成超时，请稍后重试');
            statusDiv.innerText = '✅ 生成完成！';
            document.getElementById('resultVideoArea').style.display = 'block';
            const videoElem = document.getElementById('generatedVideo');
            videoElem.src = videoUrl;
            videoElem.load();
            await refreshBalance();
            await loadHistory();
        } catch (err) {
            alert('生成失败: ' + err.message);
            statusDiv.innerText = '❌ 生成失败，积分未扣除。';
        } finally {
            genBtn.disabled = false;
            genBtn.innerText = '✨ 开始生成视频';
        }
    }

    // 界面事件绑定
    function bindUIEvents() {
        document.getElementById('txt2videoTab').addEventListener('click', () => {
            document.getElementById('txt2videoTab').classList.add('active-tab');
            document.getElementById('img2videoTab').classList.remove('active-tab');
            document.getElementById('imgUploadArea').style.display = 'none';
            document.getElementById('txt2videoTab').classList.add('bg-indigo-600/40');
            document.getElementById('img2videoTab').classList.remove('bg-indigo-600/40');
        });
        document.getElementById('img2videoTab').addEventListener('click', () => {
            document.getElementById('img2videoTab').classList.add('active-tab');
            document.getElementById('txt2videoTab').classList.remove('active-tab');
            document.getElementById('imgUploadArea').style.display = 'block';
            document.getElementById('img2videoTab').classList.add('bg-indigo-600/40');
            document.getElementById('txt2videoTab').classList.remove('bg-indigo-600/40');
        });
        document.getElementById('rechargeBtn').onclick = rechargeModal;
        document.getElementById('claimFreeBtn').onclick = claimFree;
        document.getElementById('logoutBtn').onclick = logout;
        document.getElementById('generateBtn').onclick = generateVideo;
        // 图片预览
        document.getElementById('imageUpload')?.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const previewDiv = document.getElementById('imgPreview');
                    previewDiv.style.display = 'block';
                    previewDiv.innerHTML = `<img src="${ev.target.result}" class="w-full h-full object-cover">`;
                };
                reader.readAsDataURL(file);
            }
        });
        // 灵感墙填充
        document.querySelectorAll('.badge[data-word]').forEach(el => {
            el.addEventListener('click', () => {
                const word = el.getAttribute('data-word');
                document.getElementById('promptInput').value = word;
            });
        });
        document.querySelectorAll('.badge').forEach(b=>{
            if(!b.getAttribute('data-word')) b.setAttribute('data-word', b.innerText.split(' ').slice(1).join(' '));
        });
    }

    // 样式辅助
    const style = document.createElement('style');
    style.textContent = `.active-tab { background: rgba(139, 92, 246, 0.3); border-bottom: 2px solid #a855f7; }`;
    document.head.appendChild(style);

    // 初始化: 检查token
    (async () => {
        const token = localStorage.getItem('accessToken');
        if (token) {
            try {
                await apiCall('/api/user/profile');
                await loadMainApp();
                bindUIEvents();
            } catch(e) {
                localStorage.removeItem('accessToken');
                renderAuthModal();
            }
        } else {
            renderAuthModal();
        }
    })();

    // 全局样式补丁
    const addGrid = document.createElement('link');
    addGrid.rel = "stylesheet";
    addGrid.href = "https://cdn.jsdelivr.net/npm/tailwindcss@2/dist/tailwind.min.css";
    document.head.appendChild(addGrid);
</script>

